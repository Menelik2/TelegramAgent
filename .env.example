# Server
PORT=8787
NODE_ENV=development
APP_BASE_URL=http://localhost:8787
FRONTEND_URL=http://localhost:5173
# Required to unlock dashboard mutations and private activity data; use a long random secret
DASHBOARD_API_TOKEN=
TELEGRAM_BOT_TOKEN=
TELEGRAM_WEBHOOK_SECRET=
# Comma-separated numeric Telegram sender IDs explicitly allowed to receive auto-replies
TELEGRAM_ALLOWED_USER_IDS=
# Configure an AI key on the server only
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
# Optional Supabase persistence for production
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
# Use a managed secret/key service for production encryption
APP_ENCRYPTION_KEY=
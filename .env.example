# Server
PORT=8787
NODE_ENV=development
APP_BASE_URL=http://localhost:8787
FRONTEND_URL=http://localhost:5173
VITE_API_BASE_URL=
DASHBOARD_API_TOKEN=
TELEGRAM_BOT_TOKEN=
TELEGRAM_WEBHOOK_SECRET=
TELEGRAM_ALLOWED_USER_IDS=
TELEGRAM_OWNER_USER_IDS=
# AI provider: openai (best quality) or gemini (free-tier friendly)
AI_PROVIDER=gemini
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash-lite
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
APP_ENCRYPTION_KEY=
# Smart auto-reply features
REPLY_DELAY_MS_MIN=1200
REPLY_DELAY_MS_MAX=3200
# Quiet hours example (23:00–07:00 Addis Ababa) — uncomment to enable
# QUIET_HOURS_START=23
# QUIET_HOURS_END=7
# QUIET_HOURS_TZ=Africa/Addis_Ababa
# Cap auto-replies per day (protect free Gemini quota)
# DAILY_REPLY_LIMIT=80

# Server
PORT=8787
NODE_ENV=development
APP_BASE_URL=http://localhost:8787
FRONTEND_URL=http://localhost:5173
# Frontend build-time API origin; leave blank for local Vite proxy, set on Vercel to deployed API HTTPS origin
VITE_API_BASE_URL=
# Required to unlock dashboard mutations and private activity data; use a long random secret
DASHBOARD_API_TOKEN=
TELEGRAM_BOT_TOKEN=
TELEGRAM_WEBHOOK_SECRET=
# Comma-separated numeric Telegram sender IDs explicitly allowed to receive auto-replies
TELEGRAM_ALLOWED_USER_IDS=
# Gemini API key must stay server-side; get one from https://aistudio.google.com/apikey
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.8-flash
# Optional Supabase persistence for production
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
# Use a managed secret/key service for production encryption
APP_ENCRYPTION_KEY=
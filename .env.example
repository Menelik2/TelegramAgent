# Server
PORT=8787
NODE_ENV=development
APP_BASE_URL=http://localhost:8787
FRONTEND_URL=http://localhost:5173
VITE_API_BASE_URL=
DASHBOARD_API_TOKEN=
TELEGRAM_BOT_TOKEN=
TELEGRAM_WEBHOOK_SECRET=
TELEGRAM_ALLOWED_USER_IDS=
TELEGRAM_OWNER_USER_IDS=
# Telegram groups: explicit chat ID and sender ID allowlists are both required
TELEGRAM_ALLOWED_GROUP_IDS=
TELEGRAM_BOT_USERNAME=yeniagentbot
# Optional numeric bot user ID for reply-to-bot detection
TELEGRAM_BOT_ID=
# AI provider: openai (best quality) or gemini (free-tier friendly)
AI_PROVIDER=gemini
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash-lite
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
APP_ENCRYPTION_KEY=
# Smart auto-reply features
REPLY_DELAY_MS_MIN=10000
REPLY_DELAY_MS_MAX=10000
# Quiet hours example (23:00–07:00 Addis Ababa) — uncomment to enable
# QUIET_HOURS_START=23
# QUIET_HOURS_END=7
# QUIET_HOURS_TZ=Africa/Addis_Ababa
# Cap auto-replies per day (protect free Gemini quota)
# DAILY_REPLY_LIMIT=80


# Multi-user mode: apply 20261104010000_multi_user_agent.sql before enabling.
MULTI_USER_ENABLED=false
TENANT_DAILY_REPLY_LIMIT=100
# Incoming webhooks start background reply processing by default; no extra host/secret needed.
TENANT_WORKER_MODE=webhook
# Optional: authenticate the private maintenance/recovery endpoint (32+ random characters).
CRON_SECRET=
# To use only a separate worker, set TENANT_WORKER_MODE=external, configure CRON_SECRET,
# and run npm run worker on an always-on host using APP_BASE_URL + CRON_SECRET.

# Server
PORT=8787
NODE_ENV=development
APP_BASE_URL=http://localhost:8787
FRONTEND_URL=http://localhost:5173
# Frontend build-time API origin; leave blank for local Vite proxy, set on Vercel to deployed API HTTPS origin
VITE_API_BASE_URL=
# Required to unlock dashboard mutations and private activity data; use a long random secret
DASHBOARD_API_TOKEN=
TELEGRAM_BOT_TOKEN=
TELEGRAM_WEBHOOK_SECRET=
# Comma-separated numeric Telegram sender IDs explicitly allowed to receive auto-replies
TELEGRAM_ALLOWED_USER_IDS=
# Your own numeric Telegram user id(s) — never auto-reply to these
TELEGRAM_OWNER_USER_IDS=
# AI provider: openai (best quality) or gemini (free-tier friendly)
AI_PROVIDER=openai
# OpenAI — recommended for best human-like replies: https://platform.openai.com/api-keys
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o
# Gemini — free tier alternative: https://aistudio.google.com/apikey
GEMINI_API_KEY=
# Free tier: gemini-3.5-flash-lite ~500/day; paid: gemini-2.5-flash or gemini-2.5-pro
GEMINI_MODEL=gemini-3.5-flash-lite
# Optional Supabase persistence for production
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
# Use a managed secret/key service for production encryption
APP_ENCRYPTION_KEY=
